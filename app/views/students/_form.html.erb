<%= form_with model: student do |form| %>
  <div class="form-group">
    <%= form.label :name, class:'mb-2' %>
    <%= form.text_field :name, class:"form-control form-control-lg rounded-0 mb-2" %>
    <% student.errors.full_messages_for(:name).each do |msg| %>
      <p class="text-danger"><%= msg %></p>
    <% end %>
  </div>
  <div class="form-group">
    <%= form.label :email, class:'mb-2' %>
    <%= form.text_field :email, class:"form-control form-control-lg rounded-0 mb-2" %>
    <% student.errors.full_messages_for(:email).each do |msg| %>
      <p class="text-danger"> <%= msg %></p>
    <% end %>
  </div>
  <div class="form-group">
    <%= form.label :roll_no, class:'mb-2' %>
    <%= form.text_field :roll_no, class:"form-control form-control-lg rounded-0 mb-2" %>
    <% student.errors.full_messages_for(:roll_no).each do |msg| %>
      <p class="text-danger"><%= msg %> </p>
    <% end %>
  </div>
  <div class="col-lg-12">
    <%= form.submit class:'btn btn-primary rounded-0' %>
    <%= link_to 'Back to Student', students_path ,class:"btn btn-outline-primary rounded-0" %>
  </div>
<% end %>
