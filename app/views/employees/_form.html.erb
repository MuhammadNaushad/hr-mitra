 <%= form_with model: employee do |form| %>
  <div
    class="row justify-content-center align-items-center g-2"
  >
    <div class="col-lg-4 ">
      <div class="form-group">
        <%= form.label :first_name ,class: 'mb-2' %>
        <%= form.text_field :first_name, class: 'form-control form-control-lg rounded-0' %>
        <% employee.errors.full_messages_for(:first_name).each do |msg| %>
          <p class="text-danger"><%= msg %></p>
        <% end %>
      </div>
    </div>
    <div class="col-lg-4 ">
      <div class="form-group">
        <%= form.label :middle_name ,class: 'mb-2' %>
        <%= form.text_field :middle_name, class: 'form-control form-control-lg rounded-0' %>
        <% employee.errors.full_messages_for(:middle_name).each do |msg| %>
          <p class="text-danger"><%= msg %></p>
        <% end %>
      </div>
    </div>
    <div class="col-lg-4 ">
      <div class="form-group">
        <%= form.label :last_name ,class: 'mb-2' %>
        <%= form.text_field :last_name, class: 'form-control form-control-lg rounded-0' %>
        <% employee.errors.full_messages_for(:last_name).each do |msg| %>
          <p class="text-danger"><%= msg %></p>
        <% end %>
      </div>
    </div>
  </div>
  <div
      class="row mt-3"
    >
    <div class="col-lg-4 ">
      <div class="form-group">
        <%= form.label :email ,class: 'mb-2' %>
        <%= form.text_field :email, class: 'form-control form-control-lg rounded-0', type:'email' %>
        <% employee.errors.full_messages_for(:email).each do |msg| %>
          <p class="text-danger"><%= msg %></p>
        <% end %>
      </div>
    </div>
    <div class="col-lg-8 ">
      <div class="form-group">
        <%= form.label :address ,class: 'mb-2' %>
        <%= form.text_field :address, class: 'form-control form-control-lg rounded-0' %>
        <% employee.errors.full_messages_for(:address).each do |msg| %>
          <p class="text-danger"><%= msg %></p>
        <% end %>
      </div>
    </div>
  </div>
  <div
      class="row mt-3"
    >
    <div class="col-lg-6 ">
      <div class="form-group">
        <%= form.label :state ,class: 'mb-2' %>
        <%= form.text_field :state, class: 'form-control form-control-lg rounded-0' %>
        <% employee.errors.full_messages_for(:state).each do |msg| %>
          <p class="text-danger"><%= msg %></p>
        <% end %>
      </div>
    </div>
    <div class="col-lg-6 ">
      <div class="form-group">
        <%= form.label :country ,class: 'mb-2' %>
        <%= form.text_field :country, class: 'form-control form-control-lg rounded-0' %>
        <% employee.errors.full_messages_for(:country).each do |msg| %>
          <p class="text-danger"><%= msg %></p>
        <% end %>
      </div>
    </div>
    <div class="col-lg-6 ">
      <div class="form-group">
        <%= form.label :date_of_birth ,class: 'mb-2' %>
        <%= form.date_field :date_of_birth, class: 'form-control form-control-lg rounded-0' %>
        <% employee.errors.full_messages_for(:date_of_birth).each do |msg| %>
          <p class="text-danger"><%= msg %></p>
        <% end %>
      </div>
    </div>
    <div class="col-lg-6 ">
      <div class="form-group">
        <%= form.label :date_of_joining ,class: 'mb-2' %>
        <%= form.date_field :date_of_joining, class: 'form-control form-control-lg rounded-0' %>
        <% employee.errors.full_messages_for(:date_of_joining).each do |msg| %>
          <p class="text-danger"><%= msg %></p>
        <% end %>
      </div>
    </div>
    <div class="col-lg-6 ">
      <div class="form-group">
        <%= form.label :job_title ,class: 'mb-2' %>
        <%= form.text_field :job_title, class: 'form-control form-control-lg rounded-0' %>
        <% employee.errors.full_messages_for(:job_title).each do |msg| %>
          <p class="text-danger"><%= msg %></p>
        <% end %>
      </div>
    </div>
    <div class="col-lg-12 ">
      <div class="form-group">
        <%= form.label :bio ,class: 'mb-2' %>
        <%= form.text_area :bio , class: 'form-control form-control-lg rounded-0', row: '5' %>
        <% employee.errors.full_messages_for(:bio).each do |msg| %>
          <p class="text-danger"><%= msg %></p>
        <% end %>
      </div>
    </div>
  </div>
  <div
      class="row justify-content-center align-items-center"
    >
    <div class="col-lg-12 mt-4">
      <%= form.submit class: 'btn btn-primary btn-lg rounded-0' %>
      <%= link_to 'Back To Home', employees_path ,class: ' btn btn-outline-primary btn-lg rounded-0' %>
    </div>
  </div>
<% end %>
