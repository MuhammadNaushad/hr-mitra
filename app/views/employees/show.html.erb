<div class="card mt-5 mb-5 col-lg-12">
  <div class="card-body">
    <h2 class="text-center">Employee Details</h2>
  </div>
  <div class="row mt-5">
    <div class="col-lg-6">
      <h3 class="mb-5">Personal Information</h3>
      <p class="lead"><strong>First Name: </strong>
        <%= @employee.first_name %>
      </p>
      <p class="lead"><strong>Middle Name: </strong>
        <%= @employee.middle_name.present? ? @employee.middle_name : "NA" %>
      </p>
      <p class="lead"><strong>Last Name: </strong>
        <%= @employee.last_name %>
      </p>
      <p class="lead"><strong>Email: </strong>
        <%= @employee.email %>
      </p>
    </div>
    <div class="col-lg-6">
      <h3 class="mb-5">Address Information</h3>
      <p class="lead"><strong>State: </strong>
        <%= @employee.state %>
      </p>
      <p class="lead"><strong>Country: </strong>
        <%= @employee.country %>
      </p>
      <p class="lead"><strong>Address: </strong>
        <%= @employee.address %>
      </p>
    </div>
    <% if @employee.documents.present? %>
      <div class="col-lg-6">
        <h3 class="mb-5">Employee Documents</h3>
        <% @employee.documents.each do |document| %>
          <div class="card">
            <div class="card-body mb-4">
              <div class="row">
                <% if document.image.attached? %>
                  <div class="col-lg-4 ">
                    <%= image_tag document.image , class: 'img-fluid' %>
                  </div>
                <% end %>
                <div class="col-lg-4">
                  <%= document.name %>
                </div>
                <div class="col-lg-4">
                  <%= document.doc_type %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
  <div class="col-lg-12 mt-4 ">
    <%= link_to 'Back To Employee', employees_path, class:'btn btn-outline-primary btn-lg rounded-0' %>
    <%= link_to 'Edit Employee', edit_employee_path, class: 'btn btn-primary btn-lg rounded-0' %>
  </div>
</div>
