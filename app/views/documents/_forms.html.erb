<%= form_with model: document do |forms| %>
  <div class="col-lg-4 ">
    <div class="form-group ">
      <%= forms.label :name ,class: 'mb-2' %>
      <%= forms.text_field :name, class: 'form-control form-control-lg rounded-0' %>
      <% document.errors.full_messages_for(:name).each do |msg| %>
        <p class="text-danger"><%= msg %></p>
      <% end %>
    </div>
    <div class="form-group mt-3">
      <%= forms.label :doc_type ,class: 'mb-2' %>
      <%= forms.select :doc_type , options_for_select(Document::DOC_TYPES,selected: document.doc_type ),{prompt: 'Please Select Doc Type'}, {class: 'form-select form-select-lg rounded-0'} %>
      <%#= forms.text_field :doc_type, class: 'form-control form-control-lg rounded-0' %>
      <% document.errors.full_messages_for(:doc_type).each do |msg| %>
        <p class="text-danger"><%= msg %></p>
      <% end %>
    </div>
    <div class="form-group mt-3">
      <%= forms.label :employee_id ,class: 'mb-2' %>
      <%= forms.select :employee_id , options_for_select(Employee.all.map{|employee| [employee.get_name,employee.id]},selected: document.employee_id),{prompt: 'Please Select Employee'}, {class: 'form-select form-select-lg rounded-0'} %>
      <% document.errors.full_messages_for(:employee_id).each do |msg| %>
        <p class="text-danger"><%= msg %></p>
      <% end %>
    </div>
    <div
      class="row justify-content-center align-items-center"
    >
      <div class="form-group mt-3">
        <%= forms.label :image ,class: 'mb-2' %><br>
        <%= forms.file_field :image ,class: 'mb-2' %>
      </div>
      <div class="col-lg-12 mt-4">
        <%= forms.submit  class: 'btn btn-primary btn-lg rounded-0' %>
        <%= link_to 'Back To Documents', documents_path ,class: ' btn btn-outline-primary btn-lg rounded-0' %>
      </div>
    </div>
  </div>
<% end %>
